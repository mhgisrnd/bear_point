<div class="obs-register-popup hidden" id="register-box" aria-label="관측점 등록 팝업">
  <div class="obs-register-header">
    <h2>관측점 등록</h2>
    <div class="obs-register-header-actions">
      <button class="obs-panel-icon-btn" id="btn-register-peek" type="button" aria-label="최소화" title="최소화">−</button>
      <button class="obs-register-close" id="btn-register-close" type="button" aria-label="닫기">✕</button>
    </div>
  </div>
  <div class="obs-register-body">
    <form class="obs-reg-form" id="obs-reg-form" autocomplete="off" onsubmit="return false;">

      <!-- ② 기본 정보 영역 -->
      <div class="obs-reg-section">

        <!-- 지명 -->
        <div class="obs-reg-row">
          <label class="obs-reg-label" for="reg-place">지명</label>
          <input class="obs-reg-input" id="reg-place" type="text" placeholder="지명을 입력하세요" />
        </div>

        <!-- 좌표 -->
        <div class="obs-reg-row">
          <label class="obs-reg-label">좌표</label>
          <div class="obs-reg-coord-wrap">
            <input class="obs-reg-input obs-reg-input--gps" id="reg-coord" type="text" placeholder="현재 GPS 값" readonly />
            <div class="obs-reg-coord-type">
              <label class="obs-reg-radio-label">
                <input type="radio" name="coord-type" value="tm" checked /> TM
              </label>
              <label class="obs-reg-radio-label">
                <input type="radio" name="coord-type" value="dms" /> 도분초
              </label>
            </div>
          </div>
        </div>

        <!-- 방향각 -->
        <div class="obs-reg-row">
          <label class="obs-reg-label" for="reg-heading">방향각</label>
          <input class="obs-reg-input obs-reg-input--gps" id="reg-heading" type="text" placeholder="현재 GPS 값" readonly />
        </div>

        <!-- 시간 -->
        <div class="obs-reg-row">
          <label class="obs-reg-label" for="reg-time">시간</label>
          <input class="obs-reg-input obs-reg-input--gps" id="reg-time" type="text" placeholder="현재 시간" readonly />
        </div>

        <!-- 곰 목록 -->
        <div class="obs-reg-row">
          <label class="obs-reg-label" for="reg-bear">곰 목록</label>
          <select class="obs-reg-select" id="reg-bear">
            <option value="">-- 선택 --</option>
            <option value="001">001-곰돌이</option>
            <option value="002">002-곰아빠</option>
            <option value="003">003-곰엄마</option>
          </select>
        </div>

      </div>

      <!-- ③ 감지기 영역 -->
      <div class="obs-reg-section obs-reg-section--detector">
        <div class="obs-reg-detector-header">
          <span class="obs-reg-section-title">감지기</span>
          <div class="obs-reg-detector-btns">
            <button class="obs-reg-det-btn obs-reg-det-btn--add" id="btn-det-add" type="button">+</button>
            <button class="obs-reg-det-btn obs-reg-det-btn--remove" id="btn-det-remove" type="button">−</button>
          </div>
        </div>
        <div class="obs-reg-det-table-wrap">
          <table class="obs-reg-det-table">
            <colgroup>
              <col style="width: 52%" />
              <col style="width: 48%" />
            </colgroup>
            <thead>
              <tr>
                <th>발신기명</th>
                <th>감도세기</th>
              </tr>
            </thead>
            <tbody id="det-list">
              <tr class="det-row">
                <td>
                  <select class="obs-reg-select obs-reg-select--det">
                    <option value="">-- 선택 --</option>
                    <option value="A">A발신기</option>
                    <option value="B">B발신기</option>
                    <option value="C">C발신기</option>
                  </select>
                </td>
                <td>
                  <select class="obs-reg-select obs-reg-select--det">
                    <option value="">-- 선택 --</option>
                    <option value="weak">미약</option>
                    <option value="s1">감1</option>
                    <option value="s2">감2</option>
                    <option value="s3">감3</option>
                    <option value="p1">P1</option>
                    <option value="p2">P2</option>
                    <option value="p3">P3</option>
                    <option value="p4">P4</option>
                    <option value="p5">P5</option>
                    <option value="p6">P6</option>
                    <option value="p7">P7</option>
                    <option value="p8">P8</option>
                    <option value="p9">P9</option>
                    <option value="p10">P10</option>
                  </select>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ④ 등록 / 취소 버튼 -->
      <div class="obs-reg-footer">
        <button class="obs-reg-btn obs-reg-btn--submit" id="btn-reg-submit" type="button">등록</button>
        <button class="obs-reg-btn obs-reg-btn--cancel" id="btn-reg-cancel" type="button">취소</button>
      </div>

    </form>
  </div>
</div>
